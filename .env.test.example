# Template for .env.test (gitignored). Copy to .env.test before running the
# server/integration suite:  cp .env.test.example .env.test
#
# Server tests run against a REAL PostgreSQL test database (never your dev DB —
# `npm run test:all` runs `prisma db push --accept-data-loss` against it) and an
# in-memory MongoDB (started by the test setup; no MONGODB_URL needed here).
#
# Point these at a dedicated TEST database. The defaults below match both CI and
# the `docker compose up -d db` Postgres (user/password postgres/postgres), so the
# headless setup in AGENTS.md → "Running server tests locally" works copy-paste.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrmanager_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hrmanager_test"
