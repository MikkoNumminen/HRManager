generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

model Person {
  id        String      @id @default(uuid())
  name      String
  position  String?
  email     String?
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  teams             TeamMember[]
  managedTeams      Team[]
  headOfDepartments Department[]

  @@index([deletedAt])
  @@index([sessionId])
}

model Department {
  id          String    @id @default(uuid())
  name        String
  description String?
  headId      String?
  head        Person?   @relation(fields: [headId], references: [id], onDelete: SetNull)
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  teams       Team[]

  @@index([deletedAt])
  @@index([sessionId])
}

model Team {
  teamId        String      @id @default(uuid())
  teamName      String
  teamManagerId String?
  departmentId  String?
  manager       Person?     @relation(fields: [teamManagerId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessionId     String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  members       TeamMember[]

  @@index([deletedAt])
  @@index([sessionId])
}

model TeamMember {
  id        String    @id @default(uuid())
  personId  String
  teamId    String
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id])
  team   Team   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  @@unique([personId, teamId])
  @@index([deletedAt])
  @@index([sessionId])
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  name               String?
  image              String?
  role               String           @default("user")
  permissionsVersion Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  permissions        UserPermission[]
  demoSessions       DemoSession[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  users       UserPermission[]
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model RateLimit {
  id         String   @id @default(uuid())
  identifier String
  action     String
  count      Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([identifier, action])
  @@index([windowStart])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userEmail])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([sessionId])
}

model DemoSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
}
