generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model Person {
  id                    String          @id @default(uuid())
  name                  String
  position              String?
  email                 String?
  sessionId             String?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  teams                 TeamMember[]
  managedTeams          Team[]
  headOfDepartments     Department[]
  reviewsAsSubject      ReviewRequest[] @relation("ReviewSubject")
  reviewsAsReviewer     ReviewRequest[] @relation("ReviewReviewer")
  leaveRequests         LeaveRequest[]
  leaveRequestsReviewed LeaveRequest[]  @relation("LeaveReviewer")
  leaveBalances         LeaveBalance[]

  @@index([deletedAt])
  @@index([sessionId])
  @@index([email])
  @@index([name])
}

model Department {
  id          String    @id @default(uuid())
  name        String
  description String?
  headId      String?
  head        Person?   @relation(fields: [headId], references: [id], onDelete: SetNull)
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  teams       Team[]

  @@index([deletedAt])
  @@index([sessionId])
  @@index([headId])
}

model Team {
  teamId        String       @id @default(uuid())
  teamName      String
  teamManagerId String?
  departmentId  String?
  manager       Person?      @relation(fields: [teamManagerId], references: [id], onDelete: SetNull)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessionId     String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  members       TeamMember[]

  @@index([deletedAt])
  @@index([sessionId])
  @@index([teamManagerId])
  @@index([departmentId])
}

model TeamMember {
  id        String    @id @default(uuid())
  personId  String
  teamId    String
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id])
  team   Team   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  @@unique([personId, teamId])
  @@index([deletedAt])
  @@index([sessionId])
  @@index([personId])
  @@index([teamId])
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  name               String?
  image              String?
  role               String            @default("user")
  permissionsVersion Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  permissions        UserPermission[]
  demoSessions       DemoSession[]
  sessions           UserSession[]
  twoFactorAuth      TwoFactorAuth?
  featureFlags       UserFeatureFlag[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  users       UserPermission[]
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model RateLimit {
  id          String   @id @default(uuid())
  identifier  String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([identifier, action])
  @@index([windowStart])
}

// AuditLog has been moved to MongoDB (polyglot persistence).
// See src/mongoDb.ts for the MongoDB client and AuditLogDocument interface.

model DemoSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
}

model UserSession {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent           String?
  ipAddress           String?
  active              Boolean   @default(true)
  // Set (server-side) only after a valid TOTP/recovery code is verified for
  // this session. The JWT's twoFactorVerified flag is derived from this column,
  // never from client-supplied session-update data. Null = not yet verified.
  twoFactorVerifiedAt DateTime?
  lastActiveAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, active])
  @@index([lastActiveAt])
}

model TwoFactorAuth {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String
  enabled         Boolean  @default(false)
  recoveryCodes   String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

enum QuestionType {
  RATING
  TEXT
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ReviewType {
  SELF
  MANAGER
  PEER
  DIRECT_REPORT
}

enum RequestStatus {
  PENDING
  SUBMITTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewTemplate {
  id          String        @id @default(uuid())
  name        String
  description String?
  questions   Json          @default("[]")
  cycles      ReviewCycle[]
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([deletedAt])
  @@index([sessionId])
}

model ReviewCycle {
  id         String          @id @default(uuid())
  name       String
  templateId String?
  template   ReviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status     CycleStatus     @default(DRAFT)
  startDate  DateTime
  endDate    DateTime
  requests   ReviewRequest[]
  sessionId  String?
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([deletedAt])
  @@index([sessionId])
  @@index([status])
  @@index([templateId])
}

model ReviewRequest {
  id         String            @id @default(uuid())
  cycleId    String
  cycle      ReviewCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Person?           @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewer   Person?           @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  type       ReviewType
  status     RequestStatus     @default(PENDING)
  submission ReviewSubmission?
  sessionId  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([cycleId, subjectId, reviewerId, type])
  @@index([status])
  @@index([reviewerId])
  @@index([cycleId])
  @@index([subjectId])
  @@index([sessionId])
}

model ReviewSubmission {
  id          String        @id @default(uuid())
  requestId   String        @unique
  request     ReviewRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  answers     Json          @default("[]")
  submittedAt DateTime      @default(now())
  sessionId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Position {
  id        String    @id @default(uuid())
  name      String
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, sessionId])
  @@index([deletedAt])
  @@index([sessionId])
}

model LeaveType {
  id            String         @id @default(uuid())
  name          String
  description   String?
  defaultDays   Int            @default(0)
  color         String         @default("#1976d2")
  sessionId     String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@index([deletedAt])
  @@index([sessionId])
}

model LeaveRequest {
  id          String             @id @default(uuid())
  personId    String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  days        Int
  note        String?
  status      LeaveRequestStatus @default(PENDING)
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  person    Person    @relation(fields: [personId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  reviewer  Person?   @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([deletedAt])
  @@index([sessionId])
  @@index([startDate, endDate])
  @@index([reviewerId])
}

model LeaveBalance {
  id          String   @id @default(uuid())
  personId    String
  leaveTypeId String
  year        Int
  allocated   Int      @default(0)
  used        Int      @default(0)
  sessionId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person    Person    @relation(fields: [personId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([personId, leaveTypeId, year])
  @@index([personId])
  @@index([sessionId])
  @@index([leaveTypeId])
}

enum FeatureFlagScope {
  GLOBAL
  USER
}

model FeatureFlag {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  enabled     Boolean           @default(false)
  scope       FeatureFlagScope  @default(GLOBAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userFlags   UserFeatureFlag[]
}

model UserFeatureFlag {
  id        String   @id @default(uuid())
  userId    String
  flagId    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([userId, flagId])
  @@index([userId])
}
