DATABASE_URL="postgresql://postgres:password@localhost:5432/hrmanager_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/hrmanager_dev"
MONGODB_URL="mongodb://localhost:27017/hrmanager"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Demo login is OFF by default. Set to "true" to enable the zero-credential demo provider.
# NEXT_PUBLIC_DEMO_LOGIN=true

# Sentry error tracking (optional — app works without it)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Real-time transport: "sse" (long-lived connections) or "poll" (5s interval)
# Auto-detected if unset: SSE for local/self-hosted, poll on Vercel
# NEXT_PUBLIC_REALTIME_TRANSPORT=sse

# OpenTelemetry (optional — disabled by default)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=hrmanager
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_METRIC_EXPORT_INTERVAL=60000
