DATABASE_URL="postgresql://postgres:password@localhost:5432/hrmanager_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/hrmanager_dev"
MONGODB_URL="mongodb://localhost:27017/hrmanager"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Encryption key for TOTP (2FA) secrets at rest. REQUIRED in production — the
# app refuses to derive it from the session secret there. openssl rand -base64 32
TOTP_ENCRYPTION_KEY=""
# HMAC key for the tamper-evident audit-log hash chain. REQUIRED in production.
# openssl rand -base64 32
AUDIT_HMAC_SECRET=""
# Shared secret for the scheduled cleanup endpoint (/api/cron/cleanup). Vercel
# Cron sends it automatically as a Bearer token when set.
CRON_SECRET=""
# Set "true" on long-running deployments (Docker / Kubernetes) to run the
# pg-boss background workers in-process. Leave unset on serverless (Vercel),
# where /api/cron/cleanup handles scheduled cleanup instead.
WORKERS_ENABLED="false"

# Demo login is enabled by default. Set to "false" to disable.
# NEXT_PUBLIC_DEMO_LOGIN=false

# Sentry error tracking (optional — app works without it)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Real-time transport: "sse" (long-lived connections) or "poll" (5s interval)
# Auto-detected if unset: SSE for local/self-hosted, poll on Vercel
# NEXT_PUBLIC_REALTIME_TRANSPORT=sse

# OpenTelemetry (optional — disabled by default)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=hrmanager
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_METRIC_EXPORT_INTERVAL=60000
